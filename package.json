{
  "name": "palworld-save-edit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build crates/palsave-wasm --target web --out-dir ../../src/lib/wasm --release",
    "wasm:dev": "wasm-pack build crates/palsave-wasm --target web --out-dir ../../src/lib/wasm --dev",
    "wasm:test": "wasm-pack test --node crates/palsave-wasm",
    "dev": "npm run wasm:dev && vite",
    "build": "npm run wasm && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "e2e": "cargo run --bin gen-fixtures --features synthetic -- e2e/fixtures && npm run build && playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "wasm-pack": "^0.15.0"
  }
}
